# Music API server configuration. Copy to .env and adjust, or export directly —
# the server reads plain environment variables.

# HTTP
PORT=8080
# ADDR=:8080            # overrides PORT when set (e.g. 127.0.0.1:8080)
# API_KEY=              # when set, every route except /health needs X-API-Key or Bearer
LOG_LEVEL=INFO

# Download cache — point these at the bot's own downloads dir to share the cache
DOWNLOAD_DIR=../downloads
# DB_PATH=../downloads/tracks.db
CACHE_LIMIT=1000

# yt-dlp
# YTDLP_PATH=           # explicit binary; otherwise PATH, then ../.venv, then python -m yt_dlp
PLAYLIST_END=50
RESOLVE_TIMEOUT=90s
DOWNLOAD_TIMEOUT=10m

# YouTube auth (highest priority first). Needed on server IPs, optional at home.
# YOUTUBE_COOKIES_B64=
# YOUTUBE_COOKIES_FILE=
# COOKIES_FROM_BROWSER=chrome     # local machine only
