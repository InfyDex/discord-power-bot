# Discord Bot Configuration
# Copy this file to .env and fill in your actual bot token

DISCORD_COMMAND_PREFIX=!
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_POKEMON_CHANNEL=pokemon
LOG_LEVEL=INFO
LOG_FILE=bot.log
ADMIN_USERS=id1,id2,id3

# MongoDB Configuration
MONGO_URI=mongodb://user:password@localhost:27017
MONGO_DB_NAME=legion_bot_db

# Voice Command Configuration
# Wake word for voice & natural-language text commands (default: friday)
# Users say: "friday skip", "friday play lofi", "friday stop", etc.
VOICE_WAKE_WORD=friday

# Speech-to-Text backend: "local" (free, offline) or "api" (OpenAI cloud)
STT_BACKEND=local

# Whisper model size (only used when STT_BACKEND=local)
# tiny=fastest/worst | base=good balance | small/medium/large=slower/better
STT_WHISPER_MODEL=base

# Required only when STT_BACKEND=api
# OPENAI_API_KEY=sk-...